# Copy to .env. These public defaults are for the seeded local demo.
COMPOSE_PROJECT_NAME=zqy-demo
HTTP_BIND_ADDRESS=127.0.0.1
# Optional: expose only the web UI to phones on the same trusted LAN.
# UI_BIND_ADDRESS=0.0.0.0
API_PORT=18080
UI_PORT=8080
DB_PORT=13306
MYSQL_DATABASE=zhuqiyun
MYSQL_USER=zqy
MYSQL_PASSWORD=zqy_local_demo
MYSQL_ROOT_PASSWORD=zqy_root_demo
APP_SEED=true
DEMO_PASSWORD='Zhuqi2026!'
JAVA_TOOL_OPTIONS='-XX:MaxRAMPercentage=75.0'

# Local scripts use Vite on LOCAL_UI_PORT, not Compose's UI_PORT.
LOCAL_UI_PORT=5173
# Set true only when you supply an existing database; scripts will not manage it.
LOCAL_USE_EXISTING_DB=false
# Optional existing-database overrides (uncomment together as needed).
# DB_URL='jdbc:mysql://127.0.0.1:13306/zhuqiyun?useSSL=false&allowPublicKeyRetrieval=true&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&preserveInstants=true&characterEncoding=utf8&permitMysqlScheme=true'
# DB_USER=zqy
# DB_PASSWORD=zqy_local_demo
# Optional per-task Maven cache; default: ${XDG_CACHE_HOME:-$HOME/.cache}/zhuqiyun
# ZQY_MAVEN_CACHE=/tmp/zqy-local-maven
